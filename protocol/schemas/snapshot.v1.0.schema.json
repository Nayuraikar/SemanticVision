          "description": "linear RGB in [0,1]",
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Emissive Rgb",
          "type": "array"
        },
        "screen_area": {
