  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "frame": {
      "default": 0,
      "minimum": 0,
      "title": "Frame",
      "type": "integer"
    },
    "t": {
      "default": 0.0,
      "minimum": 0,
      "title": "T",
      "type": "number"
    },
    "objects": {
      "items": {
        "$ref": "#/$defs/SceneObject"
      },
      "title": "Objects",
      "type": "array"
    },
    "lighting": {
      "discriminator": {
        "mapping": {
          "ambient_dominant": "#/$defs/AmbientDominantLighting",
          "sh2": "#/$defs/SHLighting"
        },
        "propertyName": "kind"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/SHLighting"
