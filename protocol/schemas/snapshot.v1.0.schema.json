    "DominantLight": {
      "additionalProperties": false,
      "description": "Dominant (sun/lamp) term of the lighting. rgb = normalised irradiance on a surface facing it (lit = albedo*rgb*cos).\ndirection = direction towards the light (nominal); position set => point light, rgb is its value at ref_dist.",
      "properties": {
        "rgb": {
          "description": "linear RGB in [0,1]",
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Rgb",
          "type": "array"
        },
        "direction": {
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Direction",
          "type": "array"
        },
        "position": {
          "anyOf": [
            {
              "maxItems": 3,
              "minItems": 3,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Position"
        },
        "ref_dist": {
          "default": 1.0,
          "exclusiveMinimum": 0,
          "title": "Ref Dist",
          "type": "number"
        }
      },
      "required": [
        "rgb",
        "direction"
      ],
      "title": "DominantLight",
      "type": "object"
    },
    "Event": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "state_change",
            "collision",
            "enter_view",
            "exit_view",
            "lighting_change"
          ],
          "title": "Type",
          "type": "string"
        },
        "object_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Object Id"
        },
        "data": {
          "additionalProperties": true,
          "title": "Data",
          "type": "object"
        }
      },
      "required": [
        "type"
      ],
      "title": "Event",
      "type": "object"
    },
    "SHLighting": {
      "additionalProperties": false,
      "description": "coeffs: radiance SH-L2 (real basis, l<=2) of ALL lighting incl. the dominant term. Normalised diffuse\nirradiance E(n) = sum_l (1, 2/3, 1/4)_l c_lm Y_lm(n); lit = albedo*E*exposure + emissive*exposure.",
      "properties": {
        "kind": {
          "const": "sh2",
          "default": "sh2",
          "title": "Kind",
          "type": "string"
        },
        "coeffs": {
          "description": "9 SH-L2 coeffs x RGB",
          "items": {
            "description": "linear RGB in [0,1]",
            "maxItems": 3,
            "minItems": 3,
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "type": "array"
          },
          "maxItems": 9,
          "minItems": 9,
          "title": "Coeffs",
          "type": "array"
        },
        "dominant": {
          "anyOf": [
            {
              "$ref": "#/$defs/DominantLight"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "white_point": {
          "default": [
            0.9505,
            1.0,
            1.089
          ],
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "White Point",
          "type": "array"
        },
        "exposure": {
          "default": 1.0,
          "exclusiveMinimum": 0,
          "title": "Exposure",
          "type": "number"
        }
      },
      "required": [
        "coeffs"
      ],
      "title": "SHLighting",
      "type": "object"
    },
