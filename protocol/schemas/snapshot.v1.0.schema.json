          "minItems": 3,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Albedo Rgb",
          "type": "array"
        },
        "emissive_rgb": {
          "default": [
            0.0,
